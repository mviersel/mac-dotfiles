PLUGIN_DIR="$CONFIG_DIR/plugins"

BAR_COLOR=0x00000000
PILL_COLOR=0x30ffffff
PILL_COLOR_ACTIVE=0x33b8d4b8
ACCENT_COLOR=0xffb8d4b8
TEXT_COLOR=0xfff5f5f5
MUTED_COLOR=0x99f5f5f5

sketchybar --bar position=top height=36 color="$BAR_COLOR" blur_radius=0 margin=5 y_offset=1 sticky=on

default=(
  updates=on
  icon.font="Hack Nerd Font:Bold:16.0"
  label.font="SF Pro:Semibold:13.0"
  icon.color="$ACCENT_COLOR"
  label.color="$TEXT_COLOR"
  icon.padding_left=7
  icon.padding_right=3
  label.padding_left=0
  label.padding_right=7
  padding_left=1
  padding_right=1
  background.drawing=off
)
sketchybar --default "${default[@]}"

pill=(
  background.drawing=off
)

group=(
  background.color="$PILL_COLOR"
  background.corner_radius=12
  background.height=24
  background.drawing=on
)

dot=(
  icon="○"
  icon.font="SF Pro:Heavy:14.0"
  icon.color="$MUTED_COLOR"
  label.drawing=off
  width=18
  icon.padding_left=0
  icon.padding_right=0
  padding_left=6
  padding_right=1
  background.drawing=off
  click_script=""
)

sketchybar --add event aerospace_workspace_change

workspace_items=()

sketchybar --add item apple_menu left \
  --set apple_menu \
  icon="" \
  label.drawing=off \
  padding_left=4 \
  padding_right=4 \
  icon.padding_left=8 \
  icon.padding_right=8 \
  background.color="$PILL_COLOR" \
  background.corner_radius=12 \
  background.height=24 \
  background.drawing=on \
  click_script='open -a "System Settings"'

for sid in $(aerospace list-workspaces --all); do
  display="$(
    value=$(aerospace list-windows --workspace "$sid" --format "%{monitor-appkit-nsscreen-screens-id}" | cut -c1)
    printf '%s' "${value:-1}"
  )"

  sketchybar --add item space."$sid" left \
    --subscribe space."$sid" aerospace_workspace_change \
    --set space."$sid" "${dot[@]}" \
    display="$display" \
    update_freq=2 \
    click_script="aerospace workspace $sid" \
    script="$PLUGIN_DIR/aerospace.sh $sid"

  workspace_items+=(space."$sid")
done

sketchybar --add item front_app left \
  --set front_app "${pill[@]}" \
  icon="󰀻" \
  label.max_chars=24 \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

sketchybar --add item clock right \
  --set clock "${pill[@]}" \
  icon="󰃭" \
  update_freq=10 \
  script="$PLUGIN_DIR/clock.sh"

sketchybar --add item wifi right \
  --set wifi "${pill[@]}" \
  icon="󰤯" \
  label.drawing=off \
  click_script='open "x-apple.systempreferences:com.apple.preference.network"' \
  update_freq=30 \
  script="$PLUGIN_DIR/wifi.sh"

sketchybar --add item battery right \
  --set battery "${pill[@]}" \
  update_freq=120 \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
  --set volume "${pill[@]}" \
  update_freq=5 \
  script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

sketchybar --add item weather right \
  --set weather "${pill[@]}" \
  icon="󰖙" \
  click_script='open -a Weather' \
  update_freq=900 \
  script="$PLUGIN_DIR/weather.sh"

sketchybar --add item ram right \
  --set ram "${pill[@]}" \
  icon="󰍛" \
  update_freq=10 \
  script="$PLUGIN_DIR/ram.sh"

sketchybar --add item cpu right \
  --set cpu "${pill[@]}" \
  icon="󰘚" \
  update_freq=5 \
  script="$PLUGIN_DIR/cpu.sh"

sketchybar --add bracket left_group "${workspace_items[@]}" front_app \
  --set left_group "${group[@]}"

sketchybar --add bracket right_group cpu ram weather volume battery wifi clock \
  --set right_group "${group[@]}"

sketchybar --update

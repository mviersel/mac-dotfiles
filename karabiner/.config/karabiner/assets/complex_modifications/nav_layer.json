{
  "description": "Right Command as nav layer: h/j/k/l arrows, n home, m end",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "right_command",
        "modifiers": {
          "optional": ["any"]
        }
      },
      "to": [
        {
          "set_variable": {
            "name": "nav_layer",
            "value": 1
          }
        }
      ],
      "to_after_key_up": [
        {
          "set_variable": {
            "name": "nav_layer",
            "value": 0
          }
        }
      ],
      "to_if_alone": [
        {
          "key_code": "right_command"
        }
      ]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "h",
        "modifiers": {
          "optional": ["any"]
        }
      },
      "to": [
        {
          "key_code": "left_arrow"
        }
      ],
      "conditions": [
        {
          "type": "variable_if",
          "name": "nav_layer",
          "value": 1
        }
      ]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "j",
        "modifiers": {
          "optional": ["any"]
        }
      },
      "to": [
        {
          "key_code": "down_arrow"
        }
      ],
      "conditions": [
        {
          "type": "variable_if",
          "name": "nav_layer",
          "value": 1
        }
      ]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "k",
        "modifiers": {
          "optional": ["any"]
        }
      },
      "to": [
        {
          "key_code": "up_arrow"
        }
      ],
      "conditions": [
        {
          "type": "variable_if",
          "name": "nav_layer",
          "value": 1
        }
      ]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "l",
        "modifiers": {
          "optional": ["any"]
        }
      },
      "to": [
        {
          "key_code": "right_arrow"
        }
      ],
      "conditions": [
        {
          "type": "variable_if",
          "name": "nav_layer",
          "value": 1
        }
      ]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "n",
        "modifiers": {
          "optional": ["any"]
        }
      },
      "to": [
        {
          "key_code": "home"
        }
      ],
      "conditions": [
        {
          "type": "variable_if",
          "name": "nav_layer",
          "value": 1
        }
      ]
    },
    {
      "type": "basic",
      "from": {
        "key_code": "m",
        "modifiers": {
          "optional": ["any"]
        }
      },
      "to": [
        {
          "key_code": "end"
        }
      ],
      "conditions": [
        {
          "type": "variable_if",
          "name": "nav_layer",
          "value": 1
        }
      ]
    }
  ]
}

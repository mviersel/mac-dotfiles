{
  "title": "Cross-platform screenshot key",
  "rules": [
    {
      "description": "Print Screen → macOS screenshot selection",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "print_screen"
          },
          "to": [
            {
              "key_code": "4",
              "modifiers": [
                "left_command",
                "left_shift"
              ]
            }
          ]
        }
      ]
    }
  ]
}
